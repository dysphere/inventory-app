<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Item</title>
</head>
<body>
    <h1><%= title %></h1>

    <%- include("partials/errors.ejs") %>
    <form action="/inventory/item/create" enctype="multipart/form-data" method="post">
    <label for="name">Name: </label>
    <input type="text" name="name" value="<%= item.name %>" id="name" required>
    <label for="description">Description: </label>
    <input type="text" name="description" value="<%= item.description %>" id="description" required>
    <label for="category">Category: </label>
    <select name="category" id="category">
        <% categories.forEach(function(category) { %>
            <option value="<%= category.id %>"><%= category.name %></option>
          <% }); %>
    </select>
    <label for="price">Price: </label>
    <input type="text" name="price" id="price" required>
    <label for="numberInStock">Number in Stock: </label>
    <input type="text" name="numberInStock" id="numberInStock" required>
    <button type="submit" class="submitBtn">Add Item</button>
      </form>
      <a href="/">Back to home</a>
    </ul>
</body>
</html>