<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Category detail</title>
</head>
<body>
    <h1><%= category.name %></h1>

    <h2><%= category.description %></h2>
    <ul>
        <% if (category_items.length > 0) { %>
            <% category_items.forEach(item => { %>
                <li><%= item.name %></li>
            <% }) %>
        <% } else { %>
            <li>Currently no items in this category</li>
        <% } %>
    </ul>
    <a href="/inventory/category/<%= category.id %>/update">Update</a>
    <% if (category_items.length == 0) { %>
        <form method="POST" action="/inventory/category/<%= category.id %>/delete">
            <button type="submit">Delete</button>
      </form>
        <% } %>
</body>
</html>