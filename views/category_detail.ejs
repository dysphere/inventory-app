<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Category detail</title>
</head>
<body>
    <h1><%= category.name %></h1>

    <h2><%= category.description %></h2>
    <ul>
        <% category_items.forEach(item => { %>
            <li><%= item.name %></li>
        <% }) %>
    </ul>
</body>
</html>